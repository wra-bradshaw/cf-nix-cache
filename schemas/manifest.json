{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-nix-cache.dev/schemas/manifest.json",
  "title": "cf-nix-cache chunk manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["encoding_id", "nar_hash", "nar_size", "file_hash", "file_size", "chunks", "processing_version", "created_at"],
  "properties": {
    "encoding_id": { "const": "fastcdc-v2020-min1m-avg4m-max16m-zstd3-v1" },
    "nar_hash": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" },
    "nar_size": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
    "file_hash": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" },
    "file_size": { "type": "integer", "minimum": 1, "maximum": 12884901888 },
    "chunks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["raw_hash", "raw_size", "compressed_hash", "compressed_size", "key"], "properties": { "raw_hash": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" }, "raw_size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "compressed_hash": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" }, "compressed_size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "key": { "type": "string", "pattern": "^chunks/[^/]+/sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}\\.zst$" } } } },
    "processing_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "integer", "minimum": 1 }
  }
}
