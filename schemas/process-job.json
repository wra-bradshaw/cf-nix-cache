{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-nix-cache.dev/schemas/process-job.json",
  "title": "cf-nix-cache processor job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "staging_key", "nar_hash", "nar_size", "encoding_id"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "staging_key": { "type": "string", "pattern": "^staging/[A-Za-z0-9_-]+\\.nar\\.zst$" },
    "nar_hash": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" },
    "nar_size": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
    "encoding_id": { "const": "fastcdc-v2020-min1m-avg4m-max16m-zstd3-v1" }
  }
}
