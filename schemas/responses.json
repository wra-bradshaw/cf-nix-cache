{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-nix-cache.dev/schemas/responses.json",
  "title": "cf-nix-cache API responses",
  "oneOf": [
    { "$ref": "#/$defs/api_error" },
    { "$ref": "#/$defs/cache_response" },
    { "$ref": "#/$defs/cache_page" },
    { "$ref": "#/$defs/upload_state_response" },
    { "$ref": "#/$defs/token_issue_response" },
    { "$ref": "#/$defs/token_page_response" },
    { "$ref": "#/$defs/audit_page" },
    { "$ref": "#/$defs/missing_paths_response" },
    { "$ref": "#/$defs/gc_run_response" },
    { "$ref": "#/$defs/gc_status_response" },
    { "$ref": "#/$defs/cache_upstreams_response" },
    { "$ref": "#/$defs/encoded_upload_response" },
    { "$ref": "#/$defs/encoded_upload_batch_response" },
    { "$ref": "#/$defs/encoded_complete_batch_response" }
  ],
  "$defs": {
    "api_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "cache_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "public", "quota_bytes", "logical_bytes", "encoding_id", "created_at", "lifecycle", "retention_days", "upstream_cache_key_names"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "public": { "type": "boolean" },
        "quota_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "logical_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "encoding_id": { "const": "fastcdc-v2020-min1m-avg4m-max16m-zstd3-v1" },
        "created_at": { "type": "integer", "minimum": 1 },
        "upstream_cache_key_names": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[^:\\s]{1,128}$" }, "description": "Signing key names of upstream caches. By default, push skips paths signed with these keys." },
        "retention_days": { "type": "integer", "minimum": 0, "maximum": 36500, "description": "Evict paths not accessed for this many days during garbage collection. 0 keeps paths indefinitely." },
        "lifecycle": { "enum": ["CREATING", "ACTIVE", "DELETING"] }
      }
    },
    "cache_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/cache_response" } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "upload_state_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "error"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["CREATED", "UPLOADING", "COMPLETING", "QUEUED", "PROCESSING", "PUBLISHING", "READY", "FAILED", "ABORTED"] },
        "error": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "token_issue_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "token", "expires_at", "repeated"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "repeated": { "type": "boolean" }
      }
    },
    "response_token_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "grants", "issued_at", "expires_at", "revoked"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "grants": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["cache", "role"], "properties": { "cache": { "type": "string", "pattern": "^(\\*|[a-z0-9_-]{1,64})$" }, "role": { "enum": ["pull", "push", "admin"] } } } },
        "issued_at": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "revoked": { "type": "boolean" }
      }
    },
    "token_page_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/response_token_summary" } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "audit_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "timestamp", "actor", "action", "resource", "outcome", "metadata"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "timestamp": { "type": "integer", "minimum": 1 }, "actor": { "type": "string", "minLength": 1, "maxLength": 256 }, "action": { "type": "string", "minLength": 1, "maxLength": 128 }, "resource": { "type": "string", "minLength": 1, "maxLength": 512 }, "outcome": { "enum": ["success", "accepted", "failure"] }, "metadata": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "cache_upstreams_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_cache_key_names"],
      "properties": { "upstream_cache_key_names": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[^:\\s]{1,128}$" }, "description": "Signing key names of upstream caches. By default, push skips paths signed with these keys." } }
    },
    "gc_run_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": { "run_id": { "type": "string", "minLength": 1, "maxLength": 100 } }
    },
    "gc_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "dry_run", "outcome", "started_at", "finished_at", "evicted_paths", "skipped_paths", "marked_objects", "missing_manifests", "deleted_objects", "deleted_bytes"],
      "properties": {
        "run_id": { "type": "string" },
        "dry_run": { "type": "boolean" },
        "outcome": { "enum": ["success", "failed"] },
        "started_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "finished_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "evicted_paths": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "skipped_paths": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "marked_objects": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "missing_manifests": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "deleted_objects": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "deleted_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "error": { "type": "string" }
      }
    },
    "gc_active_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "phase", "started_at", "dry_run"],
      "properties": {
        "run_id": { "type": "string" },
        "phase": { "enum": ["MARK", "DRAIN", "SWEEP"] },
        "started_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "dry_run": { "type": "boolean" }
      }
    },
    "gc_status_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_run": { "$ref": "#/$defs/gc_active_run" },
        "last_run": { "$ref": "#/$defs/gc_summary" }
      }
    },
    "missing_paths_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing"],
      "properties": {
        "missing": { "type": "array", "items": { "type": "string", "pattern": "^[0-9abcdfghijklmnpqrsvwxyz]{32}$" } },
        "pending": {
          "type": "array",
          "description": "Paths another push is uploading right now. They are not in missing; wait for the upload instead of starting another.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store_hash", "upload_id"],
            "properties": {
              "store_hash": { "type": "string", "pattern": "^[0-9abcdfghijklmnpqrsvwxyz]{32}$" },
              "upload_id": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      }
    },
    "encoded_upload_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "error", "merged", "missing_chunks"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["CREATED", "UPLOADING", "COMPLETING", "QUEUED", "PROCESSING", "PUBLISHING", "READY", "FAILED", "ABORTED"] },
        "error": { "type": ["string", "null"], "maxLength": 2000 },
        "merged": { "type": "boolean", "description": "The upload belongs to another push of the same NAR. Wait for it; do not send chunks." },
        "missing_chunks": { "type": "array", "description": "Raw hashes of the chunks the server needs. Send each once.", "items": { "type": "string", "pattern": "^sha256:[0-9abcdfghijklmnpqrsvwxyz]{52}$" } }
      }
    },
    "encoded_upload_batch_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uploads"],
      "properties": { "uploads": { "type": "array", "items": { "$ref": "#/$defs/encoded_upload_response" } } }
    },
    "encoded_complete_batch_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uploads"],
      "properties": { "uploads": { "type": "array", "items": { "$ref": "#/$defs/upload_state_response" } } }
    }
  }
}
