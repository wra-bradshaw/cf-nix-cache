{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-nix-cache.dev/schemas/responses.json",
  "title": "cf-nix-cache API responses",
  "oneOf": [
    { "$ref": "#/$defs/api_error" },
    { "$ref": "#/$defs/cache_response" },
    { "$ref": "#/$defs/cache_page" },
    { "$ref": "#/$defs/upload_state_response" },
    { "$ref": "#/$defs/initiate_upload_response" },
    { "$ref": "#/$defs/token_issue_response" },
    { "$ref": "#/$defs/token_page_response" },
    { "$ref": "#/$defs/audit_page" },
    { "$ref": "#/$defs/missing_paths_response" }
  ],
  "$defs": {
    "api_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "cache_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "public", "quota_bytes", "logical_bytes", "encoding_id", "created_at", "lifecycle"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "public": { "type": "boolean" },
        "quota_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "logical_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "encoding_id": { "const": "fastcdc-v2020-min1m-avg4m-max16m-zstd3-v1" },
        "created_at": { "type": "integer", "minimum": 1 },
        "lifecycle": { "enum": ["CREATING", "ACTIVE", "DELETING"] }
      }
    },
    "cache_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/cache_response" } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "upload_state_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "error"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["CREATED", "UPLOADING", "COMPLETING", "QUEUED", "PROCESSING", "PUBLISHING", "READY", "FAILED", "ABORTED"] },
        "error": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "initiate_upload_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "error", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["CREATED", "UPLOADING", "COMPLETING", "QUEUED", "PROCESSING", "PUBLISHING", "READY", "FAILED", "ABORTED"] },
        "error": { "type": ["string", "null"], "maxLength": 2000 },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part_number", "url"],
            "properties": {
              "part_number": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "token_issue_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "token", "expires_at", "repeated"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "repeated": { "type": "boolean" }
      }
    },
    "response_token_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "grants", "issued_at", "expires_at", "revoked"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "grants": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["cache", "role"], "properties": { "cache": { "type": "string", "pattern": "^(\\*|[a-z0-9_-]{1,64})$" }, "role": { "enum": ["pull", "push", "admin"] } } } },
        "issued_at": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "revoked": { "type": "boolean" }
      }
    },
    "token_page_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/response_token_summary" } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "audit_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "timestamp", "actor", "action", "resource", "outcome", "metadata"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "timestamp": { "type": "integer", "minimum": 1 }, "actor": { "type": "string", "minLength": 1, "maxLength": 256 }, "action": { "type": "string", "minLength": 1, "maxLength": 128 }, "resource": { "type": "string", "minLength": 1, "maxLength": 512 }, "outcome": { "enum": ["success", "accepted", "failure"] }, "metadata": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "missing_paths_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing"],
      "properties": {
        "missing": { "type": "array", "items": { "type": "string", "pattern": "^[0-9abcdfghijklmnpqrsvwxyz]{32}$" } }
      }
    }
  }
}
