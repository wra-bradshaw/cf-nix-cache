{
  "$schema": "./packages/worker/node_modules/wrangler/config-schema.json",
  "name": "cf-nix-cache",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CACHE_BUCKET",
      "bucket_name": "cf-nix-cache-dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYSTEM_CONTROL", "class_name": "SystemControl" },
      { "name": "TOKEN_CATALOG", "class_name": "TokenCatalog" },
      { "name": "AUDIT_LOG", "class_name": "AuditLog" },
      { "name": "CACHE_COORDINATOR", "class_name": "CacheCoordinator" },
      { "name": "CACHE_INDEX", "class_name": "CacheIndexShard" },
      { "name": "UPLOAD_JOB", "class_name": "UploadJob" },
      { "name": "GC_CONTROL", "class_name": "GcControl" },
    ],
  },
  "exports": {
    "SystemControl": { "type": "durable-object", "storage": "sqlite" },
    "TokenCatalog": { "type": "durable-object", "storage": "sqlite" },
    "AuditLog": { "type": "durable-object", "storage": "sqlite" },
    "CacheCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "CacheIndexShard": { "type": "durable-object", "storage": "sqlite" },
    "UploadJob": { "type": "durable-object", "storage": "sqlite" },
    "GcControl": { "type": "durable-object", "storage": "sqlite" },
  },
  "workflows": [
    {
      "name": "process-upload",
      "binding": "PROCESS_UPLOAD",
      "class_name": "ProcessUploadWorkflow",
    },
    {
      "name": "delete-cache",
      "binding": "DELETE_CACHE",
      "class_name": "DeleteCacheWorkflow",
    },
    {
      "name": "garbage-collect",
      "binding": "GARBAGE_COLLECT",
      "class_name": "GarbageCollectWorkflow",
      // Sundays at 03:00 UTC. Remove this line to run garbage collection only
      // on request.
      "schedules": ["0 3 * * SUN"],
      "limits": { "steps": 25000 },
    },
    {
      "name": "evict-cache",
      "binding": "EVICT_CACHE",
      "class_name": "EvictCacheWorkflow",
      // Daily at 04:00 UTC: retention eviction, and a check that no cache
      // over its quota watermark was missed.
      "schedules": ["0 4 * * *"],
      "limits": { "steps": 25000 },
    },
  ],
  "vars": {
    "TOKEN_ISSUER": "cf-nix-cache",
    "TOKEN_AUDIENCE": "cf-nix-cache",
    "NIX_SIGNING_KEY_NAME": "cache.nix-signing",
  },
  // NIX_PUBLIC_KEYS is a required Worker secret, not a var: a var of the same
  // name collides with the secret. Local development reads it from .dev.vars
  // (see .dev.vars.example).
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
    "traces": { "enabled": true },
  },
  "limits": { "subrequests": 10000000, "cpu_ms": 300000 },
  "env": {
    "production": {
      "name": "cf-nix-cache",
      "limits": { "subrequests": 10000000, "cpu_ms": 300000 },
      "r2_buckets": [
        { "binding": "CACHE_BUCKET", "bucket_name": "cf-nix-cache-prod" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SYSTEM_CONTROL", "class_name": "SystemControl" },
          { "name": "TOKEN_CATALOG", "class_name": "TokenCatalog" },
          { "name": "AUDIT_LOG", "class_name": "AuditLog" },
          { "name": "CACHE_COORDINATOR", "class_name": "CacheCoordinator" },
          { "name": "CACHE_INDEX", "class_name": "CacheIndexShard" },
          { "name": "UPLOAD_JOB", "class_name": "UploadJob" },
          { "name": "GC_CONTROL", "class_name": "GcControl" },
        ],
      },
      "vars": {
        "TOKEN_ISSUER": "cf-nix-cache",
        "TOKEN_AUDIENCE": "cf-nix-cache",
        "NIX_SIGNING_KEY_NAME": "cache.nix-signing",
      },
      "workflows": [
        {
          "name": "process-upload",
          "binding": "PROCESS_UPLOAD",
          "class_name": "ProcessUploadWorkflow",
        },
        {
          "name": "delete-cache",
          "binding": "DELETE_CACHE",
          "class_name": "DeleteCacheWorkflow",
        },
        {
          "name": "garbage-collect",
          "binding": "GARBAGE_COLLECT",
          "class_name": "GarbageCollectWorkflow",
          "schedules": ["0 3 * * SUN"],
          "limits": { "steps": 25000 },
        },
        {
          "name": "evict-cache",
          "binding": "EVICT_CACHE",
          "class_name": "EvictCacheWorkflow",
          // Daily at 04:00 UTC: retention eviction, and a check that no cache
          // over its quota watermark was missed.
          "schedules": ["0 4 * * *"],
          "limits": { "steps": 25000 },
        },
      ],
    },
  },
}
