{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "build/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.mts",
    "vite.config.ts",
    "vitest*.ts"
  ]
}
