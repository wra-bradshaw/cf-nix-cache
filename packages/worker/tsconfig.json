{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "worker-configuration.d.ts"]
}
