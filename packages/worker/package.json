{
  "name": "cf-nix-cache",
  "version": "0.1.1",
  "description": "The published Cloudflare Worker runtime for cf-nix-cache",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wra-bradshaw/cf-nix-cache.git",
    "directory": "packages/worker"
  },
  "homepage": "https://github.com/wra-bradshaw/cf-nix-cache#readme",
  "bugs": {
    "url": "https://github.com/wra-bradshaw/cf-nix-cache/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "release-manifest.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./release-manifest.json": "./release-manifest.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.node.json && eslint . && prettier --check . && pnpm boundaries:check && pnpm contracts:check && knip",
    "fix": "eslint . --fix && prettier --write .",
    "dev": "vite dev",
    "predev": "pnpm contracts:generate",
    "build": "vite build && node scripts/package.mts",
    "prebuild": "pnpm contracts:generate",
    "prepack": "pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "pretest": "pnpm contracts:generate",
    "contracts:generate": "node ../../scripts/generate-contracts.mts",
    "precheck": "pnpm contracts:generate",
    "pree2e": "pnpm contracts:generate",
    "precontracts:check": "pnpm contracts:generate",
    "contracts:check": "node ../../scripts/check-contracts.mts",
    "boundaries:check": "node ../../scripts/check-boundaries.mts",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "jsonc-parser": "^3.3.1",
    "json-schema-to-typescript": "^15.0.4",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.152.0"
  }
}
