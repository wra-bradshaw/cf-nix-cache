{
  "name": "cf-nix-cache",
  "version": "0.6.0",
  "description": "The published Cloudflare Worker runtime for cf-nix-cache",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wra-bradshaw/cf-nix-cache.git",
    "directory": "packages/worker"
  },
  "homepage": "https://github.com/wra-bradshaw/cf-nix-cache#readme",
  "bugs": {
    "url": "https://github.com/wra-bradshaw/cf-nix-cache/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/assets/*.wasm",
    "release-manifest.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./release-manifest.json": "./release-manifest.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mts && node scripts/build-verifier.mts",
    "check": "pnpm generate && pnpm run _lint",
    "test": "pnpm generate && pnpm run _test",
    "build": "pnpm generate && pnpm run _build",
    "e2e": "pnpm generate && pnpm run _e2e",
    "check:all": "pnpm generate && node scripts/generate-contracts.mts --check && pnpm run _lint && pnpm run _test && pnpm run _build && pnpm run _e2e",
    "dev": "pnpm generate && vite dev",
    "fix": "eslint . --fix && prettier --write .",
    "prepack": "pnpm build",
    "_lint": "tsc --noEmit && tsc -p tsconfig.node.json && eslint . && prettier --check . && node scripts/check-boundaries.mts && knip",
    "_test": "vitest run --config vitest.config.ts && vitest run --config vitest.node.config.ts",
    "_build": "vite build && node scripts/package.mts",
    "_e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "hono": "^4.13.16",
    "jose": "^6.2.14",
    "json-schema-to-typescript": "^16.0.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
